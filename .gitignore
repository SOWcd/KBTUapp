.env
__pycache__/
*.db
*.db-*
*.session
*.session.*.tmp
tmp-serve/

# an Instagram session's cookies (README, Instagram stories) never go in the repo
*cookies*.txt

# server virtualenv
server/.venv
server/media/

# test runs that point TMPDIR here (pytest-of-*)
server/tmp/

# local copies of the repo (old worktrees) and agents' scratch: never tracked, and searches (rg, Grep) skip them
/wt-*/
/.claude/worktrees/
/.claude/reports/
/.claude/assistant-docs-old-doc/
