#!/bin/sh
# English everywhere outside UI strings (AGENTS.md, Rules): refuses Cyrillic in added lines, except in the UI strings
# (web/src/lib/i18n/), the bot's texts (server/kbtu/texts.py) and server/kbtu/i18n/ (legal pages, school names), the pitch pages (web/public/pitch*.html) and the brief (web/public/sabit.html).
# In tests, write Cyrillic as \u escapes.
#   as the pre-commit hook, on what is staged:  git config core.hooksPath .githooks  (once per clone)
#   in CI, on what a PR or a push adds:         .githooks/pre-commit <base commit>
# Only added lines count, so older text elsewhere never blocks a commit that doesn't touch it.
if [ -n "$1" ]; then set -- "$1...HEAD"; else set -- --cached; fi
git -c core.quotepath=off diff "$@" -U0 --no-color --no-ext-diff --diff-filter=d -- . \
    ':(exclude)web/src/lib/i18n' ':(exclude)server/kbtu/texts.py' ':(exclude)server/kbtu/i18n' ':(exclude)web/public/pitch*.html' ':(exclude)web/public/sabit.html' |
  perl -CS -ne '
    if (/^\+\+\+ b\/(.*)/) { $f = $1; next }
    if (/^@@ -\d+(?:,\d+)? \+(\d+)/) { $n = $1; next }
    next unless /^\+/;
    if (/\p{Cyrillic}/) { print STDERR "$f:$n: $_"; $bad = 1 }
    $n++;
    END { if ($bad) { print STDERR "Cyrillic outside the UI strings (AGENTS.md, Rules): move it to i18n, or use \\u escapes in tests.\n"; exit 1 } }'
