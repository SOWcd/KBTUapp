{
  "name": "kbtu-app-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && ! grep -lE '\\(\\?<[=!]' dist/assets/*.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "size": "node tools/size.mjs",
    "size:update": "node tools/size.mjs --update",
    "e2e": "npm run build && playwright test",
    "e2e:snap": "e2e/linux.sh --project=snap-dark --project=snap-light"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/three": "0.187.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.51.0",
    "barcode-detector": "3.2.2",
    "maplibre-gl": "6.16.0",
    "qrcode-generator": "^2.0.4",
    "three": "0.187.0"
  }
}
